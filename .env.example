# OpenAI API 키 (필수)
OPENAI_API_KEY=

# Tavily 검색 API 키 (필수 — 시장/이해관계자 평가 Agent의 외부 검색 도구)
# https://app.tavily.com 에서 무료로 발급 (팀원 각자 발급, 무료 티어로 재현 가능)
# 비어있으면 외부 검색 도구가 등록되지 않고, 해당 Agent는 정직하게 "정보 부족"으로 처리함
TAVILY_API_KEY=

# LLM 모델 (RAG-Design PDF Tech Stack 절: Generator / Judge 구분)
GENERATOR_MODEL=gpt-5-mini
JUDGE_MODEL=gpt-5-mini

# Embedding / Reranker (RAG-Design PDF B.4 절, B.2 절 선정 결과)
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# cpu(기본, 모두에게 안전) | cuda | mps
# mps는 이제 락으로 동시 호출을 직렬화해 세그폴트 없이 쓸 수 있음(Apple Silicon 개인 설정용).
# 팀 공유 기본값은 cpu로 유지 — 비-Apple Silicon 환경에서도 항상 동작해야 하므로.
EMBEDDING_DEVICE=cpu

# Retrieval 파라미터 (RAG-Design PDF B.2 절)
RETRIEVAL_TOP_K_CANDIDATES=25
RETRIEVAL_TOP_K_FINAL=6
# doc_type/technology 필터 검색 시 FAISS가 필터 적용 전에 살펴보는 후보 수
RETRIEVAL_FETCH_K=500

# LangSmith 트레이싱 (동적 라우팅 확인용 — 제출 트레이스 캡처에 필요)
# https://smith.langchain.com 에서 무료 발급. run_id가 LangSmith 루트 run id/metadata로 함께 기록됨
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=kv-cache-supervisor
# 리전별 엔드포인트: US(기본) https://api.smith.langchain.com / EU https://eu.api.smith.langchain.com
#                   / APAC https://apac.api.smith.langchain.com  (리전이 다르면 키가 403으로 거부됨)
# LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com

# Supervisor 종료 보장·재작업 예산 (config.py 주석 참고)
MAX_SUPERVISOR_STEPS=30
MAX_FAILURE_RETRIES=1
MAX_REWORK_PER_AGENT=2
MAX_FAITHFULNESS_ROUNDS=2
MAX_REPORT_REVISIONS=2
# 근거 충분도 게이트 — 관점 × 기술 단위 기준
MIN_EVIDENCE_ITEMS=3
MIN_DISTINCT_SOURCES=2
# 시장성은 기술별 외부 검색 URL 출처도 최소 1종 필요
MIN_MARKET_EXTERNAL_SOURCES=1
# LangGraph 실행 상한 (Supervisor 스텝 상한과 별개의 안전장치)
GRAPH_RECURSION_LIMIT=80

# 보고서 품질 평가
MAX_REPORT_PAGES=10
MAX_SINGLE_SOURCE_RATIO=0.5
MIN_REPORT_CITATIONS=8

# 외부 검색 도구(Tavily) 결과 개수
EXTERNAL_SEARCH_MAX_RESULTS=5

# 경로
VECTORSTORE_DIR=vectorstore
CHUNKS_PATH=data/processed/chunks.jsonl
RAW_DATA_DIR=data/raw
OUTPUTS_DIR=outputs
