# OpenAI API 키 (필수)
OPENAI_API_KEY=

# LLM 모델 (RAG-Design PDF Tech Stack 절: Generator / Judge 구분)
GENERATOR_MODEL=gpt-5-mini
JUDGE_MODEL=gpt-5-mini

# Embedding / Reranker (RAG-Design PDF B.4 절, B.2 절 선정 결과)
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# cpu(기본, 권장) | cuda | mps  — mps는 병렬 Agent 동시 호출 시 세그폴트 위험이 있어 비권장
EMBEDDING_DEVICE=cpu

# Retrieval 파라미터 (RAG-Design PDF B.2 절)
RETRIEVAL_TOP_K_CANDIDATES=25
RETRIEVAL_TOP_K_FINAL=6
# doc_type/technology 필터 검색 시 FAISS가 필터 적용 전에 살펴보는 후보 수
RETRIEVAL_FETCH_K=500

# Faithfulness Check 재검색 루프 최대 횟수 (무한 루프 방지, PDF에는 명시되지 않아 v0.0에서 추가)
MAX_VERIFICATION_RETRIES=2

# 경로
VECTORSTORE_DIR=vectorstore
CHUNKS_PATH=data/processed/chunks.jsonl
RAW_DATA_DIR=data/raw
OUTPUTS_DIR=outputs
